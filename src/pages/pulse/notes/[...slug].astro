---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---
<BaseLayout title={`${note.data.title || note.id} — Pulse`}>
  <article class="note">
    <nav class="note-breadcrumb">
      <a href="/pulse/">Pulse</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">Note</span>
    </nav>

    <header class="note-header">
      <div class="note-meta-row">
        <time class="note-date" datetime={note.data.date}>{note.data.date}</time>
        {note.data.source && <span class="note-source">{note.data.source}</span>}
        <button class="star-btn-detail" data-slug={note.id} aria-label="Star this note">
          <svg class="star-outline" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg class="star-filled" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </button>
      </div>

      {note.data.tags?.length > 0 && (
        <div class="note-tags">
          {note.data.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}

      {note.data.url && (
        <a href={note.data.url} class="note-source-link" target="_blank" rel="noopener noreferrer">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
          Original source
        </a>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="note-footer">
      <a href="/pulse/" class="back-link">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to feed
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .note {
    max-width: 100%;
  }
  .note-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .note-breadcrumb a {
    color: var(--color-text-tertiary);
    transition: color 0.15s;
  }
  .note-breadcrumb a:hover { color: var(--color-accent); }
  .breadcrumb-sep { color: var(--color-border); }
  .breadcrumb-current { color: var(--color-text-secondary); }

  .note-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .note-meta-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }
  .note-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .note-source {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-tertiary);
    padding-left: 0.6rem;
    border-left: 1px solid var(--color-border);
  }
  .note-tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }
  .note-source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-accent);
    transition: opacity 0.15s;
  }
  .note-source-link:hover { opacity: 0.7; }

  .note-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-tertiary);
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--color-accent); }

  .star-btn-detail {
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: var(--color-text-tertiary);
    transition: color 0.15s, transform 0.15s;
    display: inline-flex;
    align-items: center;
    margin-left: auto;
  }
  .star-btn-detail:hover { color: #f59e0b; transform: scale(1.15); }
  .star-btn-detail .star-filled { display: none; }
  .star-btn-detail.starred { color: #f59e0b; }
  .star-btn-detail.starred .star-outline { display: none; }
  .star-btn-detail.starred .star-filled { display: block; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector<HTMLButtonElement>('.star-btn-detail');
    if (!btn) return;
    const slug = btn.dataset.slug || '';

    function getStarred(): string[] {
      try { return JSON.parse(localStorage.getItem('starred-notes') || '[]'); } catch { return []; }
    }

    function update() {
      btn.classList.toggle('starred', getStarred().includes(slug));
    }

    btn.addEventListener('click', () => {
      const starred = getStarred();
      if (starred.includes(slug)) {
        localStorage.setItem('starred-notes', JSON.stringify(starred.filter(s => s !== slug)));
      } else {
        localStorage.setItem('starred-notes', JSON.stringify([...starred, slug]));
      }
      update();
    });

    update();
  });
</script>
